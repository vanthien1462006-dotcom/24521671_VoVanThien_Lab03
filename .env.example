# Copy to .env and adjust. Never commit .env.
# API server port (server/src/server.js)
PORT=3001
# Origin allowed by the API CORS policy (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
# MongoDB connection string for the swipe deck API (server/src/server.js). Local example, no credentials.
MONGODB_URI=mongodb://localhost:27017/lab4-swipe
# Optional: a separate database for the gated integration test. The test is skipped when this is unset.
# MONGODB_URI_TEST=mongodb://localhost:27017/lab4-swipe-test
